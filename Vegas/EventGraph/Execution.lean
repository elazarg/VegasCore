import Vegas.EventGraph.Basic

/-! # Cut-based execution of event graphs

Configurations store initial values separately from optional event outputs.
Their invariant says exactly that an output is present when its event belongs
to the completed cut. Completion history is chronological and retains actual
strategic choices and public default events, including a resolving `true` whose
checked result is failure.
-/

noncomputable section

namespace Vegas

open GameTheory.Math.Probability

variable {Player : Type}
variable {L : IExpr} [R : IExpr.ResultTypes L]

namespace EventGraph

/-- A structurally coherent execution configuration. The fields tie store and
history domains exactly to the cut; semantic reachability is generated by
`initial` and `step`, rather than assumed by this carrier. -/
structure Config (graph : Vegas.EventGraph Player L) where
  inputs : graph.Inputs
  cut : graph.order.Cut
  outputs : (event : graph.EventId) → Option (graph.outputLayout event).Value
  output_available : ∀ event, (outputs event).isSome ↔ event ∈ cut.completed
  history : List graph.Completion
  history_nodup : (history.map Completion.event).Nodup
  history_exact : ∀ event, event ∈ history.map Completion.event ↔ event ∈ cut.completed

namespace Config

variable {graph : Vegas.EventGraph Player L}

/-- Public default events are derived from the one chronological completion history. -/
def defaults (config : graph.Config) : DefaultHistory Player :=
  Completion.defaults config.history

/-- The current public default set has no independent stored copy. -/
def defaulted [DecidableEq Player] (config : graph.Config) : Finset Player :=
  config.defaults.defaulted

def effectiveAction [DecidableEq Player] (config : graph.Config) (event : graph.EventId)
    (requested : graph.Action event) : graph.Action event :=
  (graph.nodes event).effectiveAction config.defaulted requested

def actualDecision [DecidableEq Player] (config : graph.Config) (event : graph.EventId)
    (requested : graph.Action event) : Option (graph.Action event) :=
  (graph.nodes event).actualDecision config.defaulted requested


instance (cut : graph.order.Cut) : Decidable cut.Terminal := by
  unfold EventOrder.Cut.Terminal
  infer_instance

/-- The initial configuration for one separately supplied input environment. -/
def initial (inputs : graph.Inputs) : graph.Config where
  inputs := inputs
  cut := EventOrder.Cut.empty graph.order
  outputs := fun _ => none
  output_available := by simp [EventOrder.Cut.empty]
  history := []
  history_nodup := by simp
  history_exact := by simp [EventOrder.Cut.empty]

/-- The combined typed partial store seen by node code. Inputs are always
available; event outputs are available exactly at completed events. -/
def store (config : graph.Config) : Store graph.layout
  | .inl input => some (config.inputs input)
  | .inr event => config.outputs event

@[simp] theorem store_input (config : graph.Config) (input : graph.InputId) :
    config.store (.inl input) = some (config.inputs input) := rfl

@[simp] theorem store_output (config : graph.Config) (event : graph.EventId) :
    config.store (.inr event) = config.outputs event := rfl

/-- Every declared read of a ready event is present in the exact store. -/
theorem read_available (config : graph.Config) {event : graph.EventId}
    (ready : config.cut.Ready event) {field : graph.Field}
    (read : field ∈ (graph.nodes event).readFields) :
    (config.store field).isSome := by
  cases field with
  | inl input => simp [store]
  | inr producer =>
      rw [store_output, config.output_available]
      exact ready.2 (graph.reads_available event (.inr producer) read)

/-- At a terminal cut every field in the combined typed store is available. -/
theorem store_available_of_terminal (config : graph.Config)
    (terminal : config.cut.Terminal) (field : graph.Field) :
    (config.store field).isSome = true := by
  cases field with
  | inl input => simp [store]
  | inr event =>
      rw [store_output, config.output_available]
      rw [EventOrder.Cut.Terminal] at terminal
      simp [terminal]

/-- Read the complete typed field environment without defaults. -/
def outcome (config : graph.Config) (terminal : config.cut.Terminal) : graph.Outcome :=
  fun field => (config.store field).get (config.store_available_of_terminal terminal field)

/-- Evaluate the graph's retained terminal payoff expressions. This is a
distinguished semantic projection of the complete outcome, not a definition of
players' utilities. -/
def terminalPayoffs (config : graph.Config) (terminal : config.cut.Terminal) :
    List (Player × L.Val L.int) :=
  graph.payoffs.map fun payoff =>
    ⟨payoff.1, (payoff.2.eval? config.store).get
      (PublicExpr.eval?_isSome payoff.2 config.store
        (fun field _ => config.store_available_of_terminal terminal field))⟩

variable [DecidableEq Player]

/-- Store one event output, extend the cut, and retain actual decisions and public default. -/
def complete (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (value : (graph.outputLayout event).Value) : graph.Config where
  inputs := config.inputs
  cut := config.cut.complete event ready
  outputs := Function.update config.outputs event (some value)
  output_available := by
    intro query
    by_cases same : query = event
    · subst query
      simp [Function.update]
    · simp only [Function.update, same]
      simpa [EventOrder.Cut.mem_complete, same] using config.output_available query
  history := config.history ++
    [Completion.fromDecision event (config.actualDecision event action) value]
  history_nodup := by
    rw [List.map_append]
    simp only [List.map_cons, List.map_nil, List.nodup_append]
    refine ⟨config.history_nodup, by simp, ?_⟩
    intro prior priorMem appended appendedMem
    have appendedEq : appended = event := by
      simpa [Completion.fromDecision] using appendedMem
    subst appended
    intro priorEq
    subst prior
    exact ready.1 ((config.history_exact event).mp priorMem)
  history_exact := by
    intro query
    simp only [List.map_append, List.map_cons, List.map_nil,
      List.mem_append, List.mem_singleton, EventOrder.Cut.mem_complete,
      Completion.fromDecision]
    rw [config.history_exact]
    tauto

@[simp] theorem complete_cut (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (value : (graph.outputLayout event).Value) :
    (config.complete event ready action value).cut = config.cut.complete event ready := rfl

@[simp] theorem complete_history (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (value : (graph.outputLayout event).Value) :
    (config.complete event ready action value).history =
      config.history ++
        [Completion.fromDecision event (config.actualDecision event action) value] := rfl

/-- The completed event stores precisely the evaluator output supplied to
`complete`; in particular, bind results retain their original value. -/
@[simp] theorem complete_output_same (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (value : (graph.outputLayout event).Value) :
    (config.complete event ready action value).outputs event = some value := by
  simp [complete, Function.update]

/-- Completing one event cannot rewrite any distinct event output. -/
theorem complete_output_of_ne (config : graph.Config) (event query : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (value : (graph.outputLayout event).Value) (different : query ≠ event) :
    (config.complete event ready action value).outputs query = config.outputs query := by
  simp [complete, Function.update, different]

/-- Execute any selected ready event. Chance remains in the returned finite
law rather than being replaced by an external choice. -/
def step (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event) :
    PMF graph.Config :=
  ((graph.nodes event).eval? (config.effectiveAction event action) config.store).get
    (EventCode.eval?_isSome_of_reads (graph.nodes event)
      (config.effectiveAction event action) config.store
      (fun _ read => config.read_available ready read)) |>.map
        (config.complete event ready action)

/-- Every configuration transition is a finite law. -/
theorem step_support_finite (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event) :
    (config.step event ready action).support.Finite := by
  rw [step, PMF.support_map]
  exact (EventCode.eval?_support_finite (graph.nodes event)
    (config.effectiveAction event action) config.store
    (Option.some_get _).symm).image _

/-- A local evaluator law determines the actual configuration transition.
The readiness proof supplies availability; it does not change the law. -/
theorem step_eq_map_of_eval (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (law : PMF (graph.outputLayout event).Value)
    (evaluates : (graph.nodes event).eval? (config.effectiveAction event action)
      config.store = some law) :
    config.step event ready action = law.map (config.complete event ready action) := by
  unfold step
  simp only [evaluates, Option.get_some]

/-- A compiler may identify an event's output kind through a typed embedding.
Transporting its code, action, and output along that same equality preserves
the ordinary graph transition. -/
theorem step_eq_map_of_code (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) {output : EventField Player L}
    (outputEq : graph.outputLayout event = output)
    (code : EventCode graph.layout output)
    (codeEq : cast (congrArg (EventCode graph.layout) outputEq) (graph.nodes event) = code)
    (action : output.Action) (law : PMF output.Value)
    (evaluates : code.eval? (code.effectiveAction config.defaulted action)
      config.store = some law) :
    config.step event ready (cast (congrArg EventField.Action outputEq.symm) action) =
      law.map (fun value => config.complete event ready
        (cast (congrArg EventField.Action outputEq.symm) action)
        (cast (congrArg EventField.Value outputEq.symm) value)) := by
  cases outputEq
  subst code
  exact config.step_eq_map_of_eval event ready action law evaluates

@[simp] theorem step_cut (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (next : graph.Config) (member : next ∈ (config.step event ready action).support) :
    next.cut = config.cut.complete event ready := by
  rw [step, PMF.support_map] at member
  obtain ⟨value, _, rfl⟩ := member
  rfl

/-- Every step records its effective value and actual strategic decision. -/
theorem step_completion (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (next : graph.Config) (member : next ∈ (config.step event ready action).support) :
    ∃ value, next.outputs event = some value ∧ next.history = config.history ++
      [Completion.fromDecision event (config.actualDecision event action) value] := by
  rw [step, PMF.support_map] at member
  obtain ⟨value, _, rfl⟩ := member
  exact ⟨value, config.complete_output_same event ready action value, rfl⟩

/-- The chronological event list still records every automatic and strategic completion. -/
@[simp] theorem step_history_events (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (next : graph.Config) (member : next ∈ (config.step event ready action).support) :
    next.history.map Completion.event = config.history.map Completion.event ++ [event] := by
  obtain ⟨value, _, history⟩ := config.step_completion event ready action next member
  rw [history, List.map_append]
  rfl

/-- A graph completion writes only its previously unavailable output field. -/
theorem complete_store_of_some (config : graph.Config)
    (event : graph.EventId) (ready : config.cut.Ready event) (action : graph.Action event)
    (output : (graph.outputLayout event).Value)
    (field : graph.Field) (value : (graph.layout field).Value)
    (stored : config.store field = some value) :
    (config.complete event ready action output).store field = some value := by
  cases field with
  | inl input => exact stored
  | inr query =>
      have different : query ≠ event := by
        intro same
        subst query
        have present : (config.outputs event).isSome := by
          change config.outputs event = some value at stored
          simp [stored]
        exact ready.1 ((config.output_available event).mp present)
      exact (config.complete_output_of_ne event query ready action output different).trans stored

/-- A graph step retains every previously available field. -/
theorem step_store_of_some (config next : graph.Config)
    (event : graph.EventId) (ready : config.cut.Ready event) (action : graph.Action event)
    (member : next ∈ (config.step event ready action).support)
    (field : graph.Field) (value : (graph.layout field).Value)
    (stored : config.store field = some value) : next.store field = some value := by
  rw [step, PMF.support_map] at member
  obtain ⟨output, _, rfl⟩ := member
  exact config.complete_store_of_some event ready action output field value stored

/-- Semantic reachability from one concrete input environment. This is the
premise under which chronological-history properties should be consumed. -/
inductive Reachable (inputs : graph.Inputs) : graph.Config → Prop
  | initial : Reachable inputs (initial inputs)
  | step {config : graph.Config} (_ : Reachable inputs config)
      (event : graph.EventId) (ready : config.cut.Ready event)
      (action : graph.Action event) (next : graph.Config)
      (_ : next ∈ (config.step event ready action).support) : Reachable inputs next

/-- In a reachable history every direct predecessor occurs strictly before
the completed event. No such claim is made for an arbitrary raw `Config`. -/
theorem Reachable.predecessor_idxOf_lt {inputs : graph.Inputs} {config : graph.Config}
    (reachable : Reachable inputs config) (event : graph.EventId)
    (completed : event ∈ config.cut.completed) (predecessor : graph.EventId)
    (isPredecessor : predecessor ∈ graph.order.predecessors event) :
    (config.history.map Completion.event).idxOf predecessor <
      (config.history.map Completion.event).idxOf event := by
  induction reachable with
  | initial =>
      change event ∈ (∅ : Finset graph.EventId) at completed
      simp at completed
  | step priorReachable newEvent ready action next supported ih =>
      rename_i priorConfig
      have cutEq := Config.step_cut _ _ ready action next supported
      have historyEq := Config.step_history_events _ _ ready action next supported
      rw [cutEq, EventOrder.Cut.mem_complete] at completed
      rw [historyEq]
      rcases completed with rfl | completedBefore
      · have predecessorBefore : predecessor ∈
            priorConfig.cut.completed := ready.2 isPredecessor
        have predecessorMem : predecessor ∈
            priorConfig.history.map Completion.event :=
          (priorConfig.history_exact predecessor).2 predecessorBefore
        have eventNotMem : event ∉
            priorConfig.history.map Completion.event := by
          intro member
          exact ready.1 ((priorConfig.history_exact event).1 member)
        rw [List.idxOf_append_of_mem predecessorMem,
          List.idxOf_append_of_notMem eventNotMem]
        simp
        simpa using List.idxOf_lt_length_of_mem predecessorMem
      · have predecessorCompleted :=
          priorConfig.cut.predecessor_closed completedBefore isPredecessor
        have eventMem : event ∈ priorConfig.history.map Completion.event :=
          (priorConfig.history_exact event).2 completedBefore
        have predecessorMem : predecessor ∈
            priorConfig.history.map Completion.event :=
          (priorConfig.history_exact predecessor).2 predecessorCompleted
        rw [List.idxOf_append_of_mem predecessorMem, List.idxOf_append_of_mem eventMem]
        exact ih completedBefore

end Config

variable [DecidableEq Player]

section

variable {graph : Vegas.EventGraph Player L}

/-- Completing an event is one typed update of the combined partial store. -/
theorem store_complete (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (value : (graph.outputLayout event).Value) :
    (config.complete event ready action value).store =
      Function.update config.store (.inr event) (some value) := by
  funext field
  cases field with
  | inl input =>
      simp [Config.store, Function.update]
      rfl
  | inr query =>
      by_cases same : query = event
      · subst query
        simp [Config.store, Config.complete, Function.update]
      · simp [Config.store, Config.complete, Function.update, same]

end

/-- A causal execution plan may randomize and adapt its next ready event and
action to the entire current semantic configuration. It cannot select an unready event.
Public/native schedulers later restrict which parts of this configuration are
observable; this ideal runner does not assume such a projection. -/
abbrev EventPlan (graph : Vegas.EventGraph Player L) :=
  (config : graph.Config) → ¬ config.cut.Terminal →
    PMF (Σ selected : {event : graph.EventId // config.cut.Ready event},
      graph.Action selected.1)

/-- Execute at most `fuel` events according to an adaptive causal plan. -/
def runPlan (graph : Vegas.EventGraph Player L) (plan : graph.EventPlan) :
    Nat → graph.Config → PMF graph.Config
  | 0, config => PMF.pure config
  | fuel + 1, config =>
      if terminal : config.cut.Terminal then
        PMF.pure config
      else
        (plan config terminal).bind fun choice =>
          (config.step choice.1.1 choice.1.2 choice.2).bind
            (graph.runPlan plan fuel)

/-- A runner branches finitely when every plan choice law does; node chance is
finite by construction. -/
theorem runPlan_support_finite (graph : Vegas.EventGraph Player L) (plan : graph.EventPlan)
    (finitePlan : ∀ config terminal, (plan config terminal).support.Finite) :
    ∀ fuel config, (graph.runPlan plan fuel config).support.Finite
  | 0, config => by simp [runPlan]
  | fuel + 1, config => by
      rw [runPlan]
      split
      · simp
      · rw [PMF.support_bind]
        refine (finitePlan _ _).biUnion fun choice _ => ?_
        rw [PMF.support_bind]
        exact (config.step_support_finite _ _ _).biUnion fun next _ =>
          graph.runPlan_support_finite plan finitePlan fuel next

/-- The complete finite runner. The event count is a sufficient fuel bound
because every step adds exactly one previously unfinished event to the cut. -/
def run (graph : Vegas.EventGraph Player L) (inputs : graph.Inputs) (plan : graph.EventPlan) :
    PMF graph.Config :=
  graph.runPlan plan graph.order.eventCount (Config.initial inputs)

/-- The finite plan runner preserves semantic reachability from fixed inputs. -/
theorem runPlan_reachable (graph : Vegas.EventGraph Player L) (plan : graph.EventPlan)
    (inputs : graph.Inputs) : ∀ fuel config next,
    Config.Reachable inputs config →
    next ∈ (graph.runPlan plan fuel config).support →
    Config.Reachable inputs next := by
  intro fuel
  induction fuel with
  | zero =>
      intro config next reachable member
      have nextEq : next = config := by simpa [runPlan] using member
      exact nextEq ▸ reachable
  | succ fuel ih =>
      intro config next reachable member
      by_cases terminal : config.cut.Terminal
      · have nextEq : next = config := by simpa [runPlan, terminal] using member
        exact nextEq ▸ reachable
      · rw [runPlan, dite_eq_right terminal, PMF.support_bind] at member
        simp only [Set.mem_iUnion] at member
        obtain ⟨choice, _, restMem⟩ := member
        rw [PMF.support_bind] at restMem
        simp only [Set.mem_iUnion] at restMem
        obtain ⟨intermediate, intermediateMem, nextMem⟩ := restMem
        have intermediateReachable : Config.Reachable inputs intermediate :=
          .step reachable choice.1.1 choice.1.2 choice.2 intermediate intermediateMem
        exact ih intermediate next intermediateReachable nextMem

/-- Every supported full-run result is reachable from the supplied inputs. -/
theorem run_reachable (graph : Vegas.EventGraph Player L) (inputs : graph.Inputs)
    (plan : graph.EventPlan) (next : graph.Config)
    (member : next ∈ (graph.run inputs plan).support) :
    Config.Reachable inputs next := by
  exact graph.runPlan_reachable plan inputs graph.order.eventCount
    (Config.initial inputs) next .initial member

/-- Number of events not yet completed. -/
def Config.remaining {graph : Vegas.EventGraph Player L} (config : graph.Config) : Nat :=
  graph.order.eventCount - config.cut.completed.card

omit [DecidableEq Player] in
theorem Config.terminal_iff_remaining_zero {graph : Vegas.EventGraph Player L}
    (config : graph.Config) : config.cut.Terminal ↔ config.remaining = 0 := by
  constructor
  · intro terminal
    rw [EventOrder.Cut.Terminal] at terminal
    simp [Config.remaining, terminal]
  · intro remaining
    unfold EventOrder.Cut.Terminal
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    have cardLe : config.cut.completed.card ≤ graph.order.eventCount := by
      simpa using Finset.card_le_card (Finset.subset_univ config.cut.completed)
    have cardEq : config.cut.completed.card = graph.order.eventCount := by
      unfold Config.remaining at remaining
      omega
    simp [cardEq]

/-- Every supported step consumes exactly one remaining event. -/
theorem Config.remaining_step {graph : Vegas.EventGraph Player L}
    (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (next : graph.Config) (member : next ∈ (config.step event ready action).support) :
    next.remaining + 1 = config.remaining := by
  rw [Config.remaining, Config.remaining, config.step_cut event ready action next member,
    EventOrder.Cut.card_complete]
  have cardLe : config.cut.completed.card < graph.order.eventCount := by
    have eventInUniv : event ∈ (Finset.univ : Finset graph.EventId) := Finset.mem_univ _
    have proper : config.cut.completed ⊂ (Finset.univ : Finset graph.EventId) :=
      Finset.ssubset_iff_subset_ne.mpr ⟨Finset.subset_univ _, by
        intro equal
        exact ready.1 (equal.symm ▸ eventInUniv)⟩
    simpa using Finset.card_lt_card proper
  omega

/-- Enough fuel completes every supported execution, independently of which
ready events and actions the randomized plan selects. -/
theorem runPlan_terminal (graph : Vegas.EventGraph Player L) (plan : graph.EventPlan) :
    ∀ fuel config next, config.remaining ≤ fuel →
      next ∈ (graph.runPlan plan fuel config).support → next.cut.Terminal := by
  intro fuel
  induction fuel with
  | zero =>
      intro config next enough member
      have zero : config.remaining = 0 := by omega
      have terminal := (config.terminal_iff_remaining_zero).2 zero
      have nextEq : next = config := by simpa [runPlan] using member
      subst next
      exact terminal
  | succ fuel ih =>
      intro config next enough member
      by_cases terminal : config.cut.Terminal
      · have nextEq : next = config := by simpa [runPlan, terminal] using member
        subst next
        exact terminal
      · rw [runPlan, dite_eq_right terminal, PMF.support_bind] at member
        simp only [Set.mem_iUnion] at member
        obtain ⟨choice, _, restMem⟩ := member
        rw [PMF.support_bind] at restMem
        simp only [Set.mem_iUnion] at restMem
        obtain ⟨intermediate, intermediateMem, nextMem⟩ := restMem
        have decreased := config.remaining_step choice.1.1 choice.1.2 choice.2
          intermediate intermediateMem
        apply ih intermediate next (by omega) nextMem

/-- The full event-count runner terminates on every supported result. -/
theorem run_terminal (graph : Vegas.EventGraph Player L) (inputs : graph.Inputs)
    (plan : graph.EventPlan) (next : graph.Config)
    (member : next ∈ (graph.run inputs plan).support) : next.cut.Terminal := by
  apply graph.runPlan_terminal plan graph.order.eventCount (Config.initial inputs) next
  · simp [Config.remaining, Config.initial]
  · exact member

end EventGraph

end Vegas

namespace Vegas.EventGraph.Config

open GameTheory.Math.Probability

variable {Player : Type} [DecidableEq Player] {L : IExpr} [IExpr.ResultTypes L]
  {graph : Vegas.EventGraph Player L}

/-- Completing one event records one public default entry in the derived history. -/
@[simp] theorem complete_defaults (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (value : (graph.outputLayout event).Value) :
    (config.complete event ready action value).defaults = config.defaults.record
      (Completion.fromDecision event (config.actualDecision event action) value).defaultEvent := by
  exact Completion.defaults_append config.history _

/-- Every event completion preserves all already public defaults. -/
theorem complete_defaulted_mono (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (value : (graph.outputLayout event).Value) :
    config.defaulted ⊆ (config.complete event ready action value).defaulted := by
  change config.defaults.defaulted ⊆
    (config.complete event ready action value).defaults.defaulted
  rw [complete_defaults]
  exact DefaultHistory.defaulted_mono _ _

/-- No supported step can restore a defaulted player. -/
theorem defaulted_step (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (action : graph.Action event)
    (next : graph.Config) (supported : next ∈ (config.step event ready action).support) :
    config.defaulted ⊆ next.defaulted := by
  rw [step, PMF.support_map] at supported
  obtain ⟨value, _, rfl⟩ := supported
  exact config.complete_defaulted_mono event ready action value

/-- An active owner records its requested strategic decision. -/
theorem actualDecision_of_active (config : graph.Config) (event : graph.EventId)
    (owner : Player) (owned : (graph.nodes event).actor = some owner)
    (active : owner ∉ config.defaulted) (action : graph.Action event) :
    config.actualDecision event action = some action := by
  simp only [actualDecision, EventCode.actualDecision, owned, ite_eq_right active]

/-- A defaulted owner contributes no further actual decision. -/
theorem actualDecision_of_defaulted (config : graph.Config) (event : graph.EventId)
    (owner : Player) (owned : (graph.nodes event).actor = some owner)
    (inactive : owner ∈ config.defaulted) (action : graph.Action event) :
    config.actualDecision event action = none :=
  (graph.nodes event).actualDecision_of_defaulted config.defaulted owner owned inactive action

/-- Mechanical completions retain event chronology without adding an actual choice or default. -/
theorem complete_history_of_defaulted (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (owner : Player)
    (owned : (graph.nodes event).actor = some owner) (inactive : owner ∈ config.defaulted)
    (action : graph.Action event) (value : (graph.outputLayout event).Value) :
    (config.complete event ready action value).history =
      config.history ++ [⟨event, none, none⟩] := by
  rw [complete_history, config.actualDecision_of_defaulted event owner owned inactive action]
  rfl

/-- A suppressed requested action has no effect on completion metadata. -/
theorem complete_eq_of_defaulted (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (owner : Player)
    (owned : (graph.nodes event).actor = some owner) (inactive : owner ∈ config.defaulted)
    (first second : graph.Action event) (value : (graph.outputLayout event).Value) :
    config.complete event ready first value = config.complete event ready second value := by
  have firstSilent := config.actualDecision_of_defaulted event owner owned inactive first
  have secondSilent := config.actualDecision_of_defaulted event owner owned inactive second
  simp only [complete, firstSilent, secondSilent]

/-- All requested actions of an excluded owner induce exactly the same graph step. -/
theorem step_eq_of_defaulted (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) (owner : Player)
    (owned : (graph.nodes event).actor = some owner) (inactive : owner ∈ config.defaulted)
    (first second : graph.Action event) :
    config.step event ready first = config.step event ready second := by
  have firstEffective :=
    (graph.nodes event).effectiveAction_of_defaulted config.defaulted owner owned inactive first
  have secondEffective :=
    (graph.nodes event).effectiveAction_of_defaulted config.defaulted owner owned inactive second
  have effectiveSame : config.effectiveAction event first =
      config.effectiveAction event second := firstEffective.trans secondEffective.symm
  have evaluatedSame := congrArg
    (fun action : graph.Action event => (graph.nodes event).eval? action config.store) effectiveSame
  have completeSame : config.complete event ready first = config.complete event ready second := by
    funext value
    exact config.complete_eq_of_defaulted event ready owner owned inactive first second value
  unfold step
  refine congrArg₂ PMF.map completeSame ?_
  apply Option.some.inj
  exact (Option.some_get _).trans (evaluatedSame.trans (Option.some_get _).symm)

end Vegas.EventGraph.Config

namespace Vegas.EventGraph.Config

variable {Player : Type} [DecidableEq Player] {L : IExpr} [IExpr.ResultTypes L]
  {graph : Vegas.EventGraph Player L}

/-- The typed compiler code certificate also identifies the exact public default event. -/
theorem complete_defaults_of_code (config : graph.Config) (event : graph.EventId)
    (ready : config.cut.Ready event) {output : EventField Player L}
    (outputEq : graph.outputLayout event = output)
    (code : EventCode graph.layout output)
    (codeEq : cast (congrArg (EventCode graph.layout) outputEq) (graph.nodes event) = code)
    (action : output.Action) (value : output.Value) :
    (config.complete event ready (cast (congrArg EventField.Action outputEq.symm) action)
      (cast (congrArg EventField.Value outputEq.symm) value)).defaults =
        config.defaults.record ((code.actualDecision config.defaulted action).bind fun chosen =>
          code.defaultEvent chosen value) := by
  cases outputEq
  subst code
  exact config.complete_defaults event ready action value

end Vegas.EventGraph.Config

namespace Vegas.EventGraph.Config

variable {Player : Type} [DecidableEq Player] {L : IExpr} [IExpr.ResultTypes L]
  {graph : Vegas.EventGraph Player L}

/-- One supported transition of the graph's authoritative executor. -/
def Step (before after : graph.Config) : Prop :=
  ∃ event, ∃ ready : before.cut.Ready event, ∃ action : graph.Action event,
    after ∈ (before.step event ready action).support

namespace Step

/-- A supported transition preserves reachability from fixed inputs. -/
theorem reachable {before after : graph.Config} (moved : Step before after)
    {inputs : graph.Inputs} (reachable : before.Reachable inputs) : after.Reachable inputs := by
  obtain ⟨event, ready, action, supported⟩ := moved
  exact .step reachable event ready action after supported

/-- A supported transition preserves all public defaults. -/
theorem defaulted_mono {before after : graph.Config} (moved : Step before after) :
    before.defaulted ⊆ after.defaulted := by
  obtain ⟨event, ready, action, supported⟩ := moved
  exact before.defaulted_step event ready action after supported

/-- Every supported transition extends the one authoritative completion history. -/
theorem history_prefix {before after : graph.Config} (moved : Step before after) :
    before.history.IsPrefix after.history := by
  obtain ⟨event, ready, action, supported⟩ := moved
  obtain ⟨value, _, history⟩ := before.step_completion event ready action after supported
  exact ⟨[Completion.fromDecision event (before.actualDecision event action) value], history.symm⟩

/-- A finite supported execution path retains every recorded decision and default entry. -/
theorem path_history_prefix {before after : graph.Config}
    (path : Relation.ReflTransGen Step before after) :
    before.history.IsPrefix after.history := by
  induction path using Relation.ReflTransGen.head_induction_on with
  | refl => exact ⟨[], by simp⟩
  | @head before middle moved _ ih => exact moved.history_prefix.trans ih

/-- Any finite supported execution path preserves reachability from fixed inputs. -/
theorem path_reachable {before after : graph.Config}
    (path : Relation.ReflTransGen Step before after) {inputs : graph.Inputs} :
    before.Reachable inputs → after.Reachable inputs := by
  induction path using Relation.ReflTransGen.head_induction_on with
  | refl => exact id
  | @head before middle moved _ ih => exact fun valid => ih (moved.reachable valid)

/-- Any finite supported execution path preserves all public defaults. -/
theorem path_defaulted_mono {before after : graph.Config}
    (path : Relation.ReflTransGen Step before after) : before.defaulted ⊆ after.defaulted := by
  induction path using Relation.ReflTransGen.head_induction_on with
  | refl => exact Finset.Subset.refl _
  | @head before middle moved _ ih => exact moved.defaulted_mono.trans ih

/-- No supported execution path can change a terminal configuration. -/
theorem path_eq_of_terminal {before after : graph.Config}
    (path : Relation.ReflTransGen Step before after) (terminal : before.cut.Terminal) :
    after = before := by
  induction path using Relation.ReflTransGen.head_induction_on with
  | refl => rfl
  | @head before middle moved _ _ =>
      obtain ⟨event, ready, _, _⟩ := moved
      exact (ready.1 (by rw [terminal]; exact Finset.mem_univ event)).elim

end Step

/-- A typed code identification determines the exact new public default entry. -/
theorem completion_defaultEvent_of_code (config : graph.Config) (event : graph.EventId)
    {output : EventField Player L} (outputEq : graph.outputLayout event = output)
    (code : EventCode graph.layout output)
    (codeEq : cast (congrArg (EventCode graph.layout) outputEq) (graph.nodes event) = code)
    (action : output.Action) (value : output.Value) :
    (Completion.fromDecision event
      (config.actualDecision event (cast (congrArg EventField.Action outputEq.symm) action))
      (cast (congrArg EventField.Value outputEq.symm) value)).defaultEvent =
      (code.actualDecision config.defaulted action).bind
        (fun chosen => code.defaultEvent chosen value) := by
  cases outputEq
  subst code
  rfl

/-- Admitting an opaque binding is not a public default, regardless of its hidden value. -/
theorem completion_bind_some_defaultEvent (config : graph.Config) (event : graph.EventId)
    (owner : Player) (payload : L.Ty)
    (outputEq : graph.outputLayout event = .binding owner payload)
    (codeEq : cast (congrArg (EventCode graph.layout) outputEq)
      (graph.nodes event) = .bind owner payload)
    (choice value : PublicationResult (L.Val payload)) :
    (Completion.fromDecision event
      (config.actualDecision event
        (cast (congrArg EventField.Action outputEq.symm) (some choice)))
      (cast (congrArg EventField.Value outputEq.symm) value)).defaultEvent = none := by
  rw [config.completion_defaultEvent_of_code event outputEq (.bind owner payload)
    codeEq (some choice) value]
  by_cases inactive : owner ∈ config.defaulted <;>
    simp [EventCode.actualDecision, EventCode.actor, EventCode.defaultEvent,
      EventCode.causesDefault, inactive]

/-- An omission records a new default precisely when its owner was still active. -/
theorem completion_bind_none_defaultEvent (config : graph.Config) (event : graph.EventId)
    (owner : Player) (payload : L.Ty)
    (outputEq : graph.outputLayout event = .binding owner payload)
    (codeEq : cast (congrArg (EventCode graph.layout) outputEq)
      (graph.nodes event) = .bind owner payload)
    (value : PublicationResult (L.Val payload)) :
    (Completion.fromDecision event
      (config.actualDecision event
        (cast (congrArg EventField.Action outputEq.symm)
          (none : Option (PublicationResult (L.Val payload)))))
      (cast (congrArg EventField.Value outputEq.symm) value)).defaultEvent =
      if owner ∈ config.defaulted then none else some owner := by
  rw [config.completion_defaultEvent_of_code event outputEq (.bind owner payload)
    codeEq none value]
  by_cases inactive : owner ∈ config.defaulted <;>
    simp [EventCode.actualDecision, EventCode.actor, EventCode.defaultEvent,
      EventCode.causesDefault, inactive]

/-- A publication's new public default depends on its result and prior status. -/
theorem completion_resolve_defaultEvent (config : graph.Config) (event : graph.EventId)
    (owner : Player) (payload : L.Ty)
    (binding : FieldRef graph.layout (.binding owner payload))
    (checks : List (GuardCheck graph.layout payload))
    (outputEq : graph.outputLayout event = .publication payload)
    (codeEq : cast (congrArg (EventCode graph.layout) outputEq)
      (graph.nodes event) = .resolve owner payload binding checks)
    (disclose : Bool) (value : PublicationResult (L.Val payload)) :
    (Completion.fromDecision event
      (config.actualDecision event (cast (congrArg EventField.Action outputEq.symm) disclose))
      (cast (congrArg EventField.Value outputEq.symm) value)).defaultEvent =
      if owner ∈ config.defaulted then none else if value.isFailure then some owner else none := by
  rw [config.completion_defaultEvent_of_code event outputEq
    (.resolve owner payload binding checks) codeEq disclose value]
  by_cases inactive : owner ∈ config.defaulted <;>
    simp [EventCode.actualDecision, EventCode.actor, EventCode.defaultEvent,
      EventCode.causesDefault, inactive]

end Vegas.EventGraph.Config
