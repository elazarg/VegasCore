import Vegas.Game.SourceServiceFactorization
import Vegas.Game.RecoveryInitialCheckpoint
import Vegas.Pending.PhaseTraffic

/-! # Correlated input draws and initial phase traffic

Equal original source observations give equal complete focal phase traffic at
initialization, including owned initial candidates, accepted handles and phase
metadata. The actual initial law therefore factors through that source view
without an independence assumption on private inputs.
-/

noncomputable section

namespace Vegas

open SourceProgram EventGraph EventGraphRuntime Interaction GameTheory.Math.Probability

variable {Player : Type} [DecidableEq Player] {L : IExpr} [IExpr.ResultTypes L]
  (setup : Setup (Player := Player) (L := L)) (mode : ExecutionMode)
  (runtime : EventGraphRuntime (serviceGraph setup mode))
  (leaks : MessageNetwork.ObservationRule Player (CommitAttemptPacket (serviceGraph setup mode)))
  (plan : RuntimePhasePlan (serviceGraph setup mode))

local notation "app" => phaseApplication runtime leaks
local notation "start" => fun input => ReactiveApplication.Execution.initial (app)
  (PhaseRuntimeState.initial plan (encodeInputs input))

/-- The initial physical traffic is determined by the observing player's source
view, even when all initial types are correlated. -/
theorem sourcePhase_initial_traffic_eq (focal : Player)
    (left right : State L setup.context)
    (same : sourceObserve focal left = sourceObserve focal right) :
    phaseTraffic runtime leaks focal (start left) =
      phaseTraffic runtime leaks focal (start right) := by
  let nativeLeaks : MessageNetwork.ObservationRule Player
      (WitnessedPacket (serviceGraph setup mode)) := fun _ _ => PMF.pure ∅
  have original := source_initial_traffic_eq setup (deadline := fun _ => 0)
    nativeLeaks focal left right (Prod.ext same rfl)
  have views :
      (EventGraphRuntime.State.initial (graph := serviceGraph setup mode)
        (encodeInputs left)).playerView focal =
      (EventGraphRuntime.State.initial (graph := serviceGraph setup mode)
        (encodeInputs right)).playerView focal :=
    congrArg (fun traffic => traffic.2.2.2.2.1) original
  have publics :
      (EventGraphRuntime.State.initial (graph := serviceGraph setup mode)
        (encodeInputs left)).publicView =
      (EventGraphRuntime.State.initial (graph := serviceGraph setup mode)
        (encodeInputs right)).publicView :=
    congrArg (fun traffic => traffic.2.2.2.2.2) original
  have phaseViews :
      (PhaseRuntimeState.initial plan (encodeInputs left)).playerView focal =
      (PhaseRuntimeState.initial plan (encodeInputs right)).playerView focal := by
    rw [phaseInitial_eq_raw, phaseInitial_eq_raw]
    unfold PhaseRuntimeState.playerView
    apply Prod.ext views
    unfold PhaseRuntimeState.publicView
    rw [publics]
    rfl
  unfold phaseTraffic
  dsimp only [ReactiveApplication.Execution.initial]
  rw [phaseViews]

/-- The initial joint input/traffic law is generated by a channel depending
only on the original focal source observation. -/
theorem sourcePhase_initial_noise_factorization (focal : Player) :
    ∃ noise : SourceObservation L focal setup.context → PMF _,
      setup.initialLaw.map (fun input => (input, phaseTraffic runtime leaks focal (start input))) =
        setup.initialLaw.bind fun input => (noise (sourceObserve focal input)).map
          fun extra => (input, extra) := by
  classical
  let read := fun input : State L setup.context => phaseTraffic runtime leaks focal (start input)
  let noise := fun view : SourceObservation L focal setup.context =>
    if present : ∃ input ∈ setup.initialLaw.support, sourceObserve focal input = view then
      PMF.pure (read present.choose)
    else PMF.pure (read setup.initialLaw.support_nonempty.choose)
  refine ⟨noise, ?_⟩
  change setup.initialLaw.bind (fun input => PMF.pure (input, read input)) = _
  apply bind_congr_on_support _
  intro input supported
  have present : ∃ other ∈ setup.initialLaw.support,
      sourceObserve focal other = sourceObserve focal input := ⟨input, supported, rfl⟩
  simp only [noise, dite_eq_left present, PMF.pure_map]
  rw [show read input = read present.choose from
    sourcePhase_initial_traffic_eq setup mode runtime leaks plan focal input present.choose
      present.choose_spec.2.symm]

end Vegas
