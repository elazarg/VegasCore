import Vegas.Source.CommitRecoveryNoMiss
import Vegas.Source.CommitRecoveryValueMenu
import Vegas.Source.CommitRecoveryBlockPath

/-! # Genuine source information after a replay without new omissions

The replay extends the same initialized source history by actual legal source
instructions. Its signals and own-play tags are generated by those transitions;
they are not assembled from an independently selected observation.
-/

noncomputable section

namespace Vegas.SourceProgram

open GameTheory.Protocol GameTheory.Protocol.ExecutionProtocol GameTheory.Math.Probability

variable {Player : Type} [DecidableEq Player] {L : IExpr} [IExpr.ResultTypes L]

namespace ProtocolSuffix

/-- A syntactic suffix preserves the actual instruction rank. -/
theorem remaining_lift {wholeΓ Γ : SourceCtx Player L} {wholeO O : Finset VarId}
    {whole : SourceProgram Player L wholeΓ wholeO} {program : SourceProgram Player L Γ O}
    {lift : ProtocolState program → ProtocolState whole}
    (origin : ProtocolSuffix whole program lift) :
    ∀ point, ProtocolState.remaining whole (lift point) =
      ProtocolState.remaining program point := by
  induction origin with
  | initial => intro point; rfl
  | sampleTail _ _ _ _ ih => intro point; exact ih (.inr point)
  | commitTail _ _ _ _ ih => intro point; exact ih (.inr point)
  | revealTail _ _ _ _ _ ih => intro point; exact ih (.inr point)

/-- The real recovery kernel traverses a syntactic suffix without changing
its omission flags or sampled public values. -/
theorem recoveryStep_lift {wholeΓ Γ : SourceCtx Player L} {wholeO O : Finset VarId}
    {whole : SourceProgram Player L wholeΓ wholeO} {program : SourceProgram Player L Γ O}
    {lift : ProtocolState program → ProtocolState whole}
    (origin : ProtocolSuffix whole program lift) :
    ∀ point excluded joint,
      ProtocolState.recoveryStep whole (lift point) excluded joint =
        (ProtocolState.recoveryStep program point excluded joint).map
          (fun result => (lift result.1, result.2)) := by
  induction origin with
  | initial => intro point excluded joint; exact (PMF.map_id _).symm
  | sampleTail _ _ _ _ ih =>
      intro point excluded joint
      simpa only [ProtocolState.recoveryStep, Sum.elim_inr, PMF.map_comp, Function.comp_def]
        using ih (.inr point) excluded joint
  | commitTail _ _ _ _ ih =>
      intro point excluded joint
      simpa only [ProtocolState.recoveryStep, Sum.elim_inr, PMF.map_comp, Function.comp_def]
        using ih (.inr point) excluded joint
  | revealTail _ _ _ _ _ ih =>
      intro point excluded joint
      simpa only [ProtocolState.recoveryStep, Sum.elim_inr, PMF.map_comp, Function.comp_def]
        using ih (.inr point) excluded joint

end ProtocolSuffix

namespace Setup

variable (setup : Setup (Player := Player) (L := L))

/-- Retaining a supported instruction path constructs an actual initialized
history extension with that exact word. All old information remains literal. -/
theorem recoveryInstructionPath_information
    (initial : Config Player L setup.context)
    {joints : List (Player → Option (CommitRecoveryMove Player L))}
    {addresses : List (Option Nat × (Finset Player × Nat × Nat))}
    {first last : CommitRecoveryState setup.program}
    (path : CommitRecoveryState.InstructionPath setup.program initial joints addresses first last)
    (prior : setup.commitRecoveryProtocol.Trace (some first)) :
    ∃ trace : setup.commitRecoveryProtocol.Trace (some last),
      setup.commitRecoveryProtocol.ReachesWithin joints.length
        ⟨some first, prior⟩ ⟨some last, trace⟩ ∧
      trace.length = prior.length + joints.length ∧
      setup.recoveryJointRecall trace = joints.reverse ++ setup.recoveryJointRecall prior ∧
      setup.recoveryAddressWord trace = setup.recoveryAddressWord prior ++ addresses := by
  induction path with
  | refl state =>
      exact ⟨prior, .refl 0 _, by simp only [List.length_nil, Nat.add_zero], rfl,
        (List.append_nil _).symm⟩
  | @step first middle last joint rest addresses legal supported later ih =>
      have legal' : setup.commitRecoveryProtocol.Legal (some first) joint := legal
      have supported' : some middle ∈
          (setup.commitRecoveryProtocol.step (some first) ⟨joint, legal'⟩).support :=
        (PMF.mem_support_map_iff _ _ _).mpr ⟨middle, supported, rfl⟩
      let next := prior.extend joint legal' supported'
      obtain ⟨trace, reached, length, word, controls⟩ := ih next
      refine ⟨trace, ?_, ?_, ?_, ?_⟩
      · simpa only [List.length_cons] using
          (ReachesWithin.step (E := setup.commitRecoveryProtocol) joint legal' supported' reached)
      · simp only [next, Trace.length, List.length_cons] at length ⊢
        omega
      · simpa only [next, recoveryJointRecall, List.reverse_cons, List.append_assoc,
          List.singleton_append] using word
      · simpa only [next, recoveryAddressWord_extend, Option.elim_some, List.append_assoc,
          List.singleton_append] using controls

/-- The no-new-omission representative is a genuine replay of the saved
source history, with all prior signals and the full new own-play record.
The original setup draw is retained. -/
theorem commitRecovery_noMiss_information
    {Γ Δ : SourceCtx Player L} {O P : Finset VarId}
    {block : CommitPrefix Γ O Δ P} {entry : Config Player L Γ}
    {excluded : Finset Player} {finished : Config Player L Δ} {after : Finset Player}
    (attempt : block.Attempt entry excluded finished after)
    (saved : Finset Player) (inherited : saved ⊆ excluded)
    (replacement : Config Player L Γ) (suffix : SourceProgram Player L Δ P)
    {lift : SourceProgram.ProtocolState (block.prepend suffix) →
      SourceProgram.ProtocolState setup.program}
    (origin : ProtocolSuffix setup.program (block.prepend suffix) lift)
    (state : CommitRecoveryState setup.program)
    (prior : setup.commitRecoveryProtocol.Trace (some state))
    (atEntry : state.point = lift (ProtocolState.entry (block.prepend suffix) replacement))
    (stateExcluded : state.excluded = saved)
    (committing : ProtocolState.atCommit setup.program state.saved = true)
    (endpoint : ProtocolState.commitEnd setup.program state.saved ≤ instructionCount suffix)
    (positive : 0 < block.length) :
    let replay := attempt.withoutMisses_attempt saved inherited replacement
    let last := (state.install
      (lift (block.liftPoint suffix (ProtocolState.entry suffix
        (attempt.withoutMisses saved replacement))), saved)
      (fun _ member => stateExcluded ▸ member)).close
    ∃ trace : setup.commitRecoveryProtocol.Trace (some last),
      setup.commitRecoveryProtocol.ReachesWithin block.length
        ⟨some state, prior⟩ ⟨some last, trace⟩ ∧
      trace.length = prior.length + block.length ∧
      setup.recoveryJointRecall trace =
        replay.joints.reverse ++ setup.recoveryJointRecall prior := by
  let replay := attempt.withoutMisses_attempt saved inherited replacement
  obtain ⟨_addresses, path, _exclusions⟩ := replay.instructions_closed_lift setup.program
    (setup.initialConfig setup.initialLaw.support_nonempty.choose)
    suffix lift origin.remaining_lift origin.actor_lift (fun point who =>
      origin.recoveryAvailable who point) origin.recoveryStep_lift state atEntry stateExcluded
    committing endpoint positive
  obtain ⟨trace, reached, length, word, _controls⟩ :=
    setup.recoveryInstructionPath_information
      (setup.initialConfig setup.initialLaw.support_nonempty.choose) path prior
  exact ⟨trace, by simpa only [replay.joints_length] using reached,
    by simpa only [replay.joints_length] using length, word⟩

end Setup
end Vegas.SourceProgram
